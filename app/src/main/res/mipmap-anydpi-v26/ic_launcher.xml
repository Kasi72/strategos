<?xml version="1.0" encoding="utf-8"?>
<!-- PNG layers (rendered from drawable/vector_logo.xml): some launchers (ColorOS) fall back to the default robot icon
     when an adaptive icon layer is a vector. The monochrome layer is for Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
