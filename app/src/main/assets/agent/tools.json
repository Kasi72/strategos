[
  {
    "type": "function",
    "name": "ask_user",
    "description": "Show 1-3 short questions with tap options. Ends your turn.",
    "parameters": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "questions"
      ]
    }
  },
  {
    "type": "function",
    "name": "explain_framework",
    "description": "Explain one framework from the last analysis.",
    "parameters": {
      "type": "object",
      "properties": {
        "module_id": {
          "type": "string"
        }
      },
      "required": [
        "module_id"
      ]
    }
  },
  {
    "type": "function",
    "name": "get_scenario",
    "description": "Full model digest. The app context already has a short one.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "type": "function",
    "name": "propose_changes",
    "description": "Change the model. Guided mode applies at once; Expert mode waits for the user's review.",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "set_scenario_fields",
                  "add_stakeholder",
                  "update_stakeholder",
                  "remove_stakeholder",
                  "add_action",
                  "update_action",
                  "remove_action",
                  "set_payoff",
                  "add_constraint",
                  "add_belief",
                  "add_assumption"
                ]
              },
              "ref": {
                "type": "string"
              },
              "target_id": {
                "type": "string"
              },
              "stakeholder": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "game_role": {
                "type": "string",
                "enum": [
                  "PLAYER",
                  "INFLUENCER"
                ]
              },
              "authority": {
                "type": "integer"
              },
              "influence": {
                "type": "integer"
              },
              "can_veto": {
                "type": "boolean"
              },
              "can_delay": {
                "type": "boolean"
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fears": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "label": {
                "type": "string"
              },
              "profile": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stakeholder": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    }
                  }
                }
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "enum": [
                        "SAFETY",
                        "ETHICS",
                        "LEGALITY",
                        "COST",
                        "REPUTATION",
                        "RELATIONSHIPS",
                        "WELLBEING",
                        "EFFICIENCY",
                        "PUBLIC_TRUST",
                        "LONG_TERM_VALUE"
                      ]
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              "constraint_kind": {
                "type": "string",
                "enum": [
                  "LEGAL",
                  "ETHICAL",
                  "SAFETY",
                  "POLICY",
                  "PHYSICAL",
                  "RESOURCE"
                ]
              },
              "probability": {
                "type": "number"
              },
              "scenario_fields": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "decision_owner": {
                    "type": "string"
                  },
                  "stakes": {
                    "type": "string"
                  }
                }
              },
              "rationale": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "ai_inferred",
                  "user_stated"
                ]
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "rationale"
            ]
          }
        }
      },
      "required": [
        "summary",
        "ops"
      ]
    }
  },
  {
    "type": "function",
    "name": "run_analysis",
    "description": "Run the on-device engine on the model and return its result.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "type": "function",
    "name": "show_support",
    "description": "Show the support and crisis card. Use whenever someone's safety may be at risk.",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "self_harm",
            "harm_to_others",
            "abuse",
            "immediate_danger",
            "distress"
          ]
        }
      },
      "required": [
        "reason"
      ]
    }
  },
  {
    "type": "function",
    "name": "show_understanding",
    "description": "Show a plain recap (2-8 short bullets) with Looks right / Fix buttons. Ends your turn.",
    "parameters": {
      "type": "object",
      "properties": {
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "bullets"
      ]
    }
  },
  {
    "type": "function",
    "name": "stress_test_inferred",
