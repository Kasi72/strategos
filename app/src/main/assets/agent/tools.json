[
  {
    "type": "function",
    "name": "ask_user",
    "description": "Shows up to 3 short questions as tappable cards. Ends your turn. The user's answer arrives as their next message.",
    "parameters": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 4
              },
              "allow_free_text": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "questions"
      ]
    }
  },
  {
    "type": "function",
    "name": "explain_framework",
    "description": "Returns the findings, assumptions and explanation of one framework module from the most recent analysis.",
    "parameters": {
      "type": "object",
      "properties": {
        "module_id": {
          "type": "string",
          "description": "e.g. pure-nash, stackelberg, minimax-regret"
        }
      },
      "required": [
        "module_id"
      ]
    }
  },
  {
    "type": "function",
    "name": "get_scenario",
    "description": "Returns a compact JSON digest of the current decision model, including ids, players, influencers, actions, payoff coverage, missing profiles, constraints, beliefs and validity issues.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "type": "function",
    "name": "propose_changes",
    "description": "Proposes a batch of model changes for the user to review. Nothing changes until the user applies them. New entities get a `ref` that later ops in the same batch can use. Returns real ids for accepted ops and reasons for rejected ones.",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "One line shown to the user, e.g. 'Add the regulator and the staff union'"
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "set_scenario_fields",
                  "add_stakeholder",
                  "update_stakeholder",
                  "remove_stakeholder",
                  "add_action",
                  "update_action",
                  "remove_action",
                  "set_payoff",
                  "add_constraint",
                  "add_belief",
                  "add_assumption"
                ]
              },
              "ref": {
                "type": "string",
                "description": "handle for a NEW entity, [a-z0-9_]{2,40}, unique in this batch"
              },
              "target_id": {
                "type": "string",
                "description": "id of an EXISTING entity for update_/remove_"
              },
              "stakeholder": {
                "type": "string",
                "description": "existing stakeholder id OR a ref defined earlier in this batch"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "stakeholder_type": {
                "type": "string",
                "enum": [
                  "INDIVIDUAL",
                  "DEPARTMENT",
                  "INSTITUTION",
                  "REGULATOR",
                  "PUBLIC",
                  "PATIENT_GROUP",
                  "VENDOR",
                  "MEDIA",
                  "POLITICAL_ACTOR",
                  "COMMITTEE",
                  "UNION",
                  "COMMUNITY",
                  "OTHER"
                ]
              },
              "game_role": {
                "type": "string",
                "enum": [
                  "PLAYER",
                  "INFLUENCER"
                ]
              },
              "authority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "influence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "credibility": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "can_veto": {
                "type": "boolean"
              },
              "can_exit": {
                "type": "boolean"
              },
              "can_delay": {
                "type": "boolean"
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 5
              },
              "fears": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 5
              },
              "incentives": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 5
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "reversible": {
                "type": "boolean"
              },
              "legal_status": {
                "type": "string",
                "enum": [
                  "PERMITTED",
                  "RESTRICTED",
                  "PROHIBITED",
                  "UNCLEAR"
                ]
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "cost": {
                "type": "number"
              },
              "time_cost_days": {
                "type": "integer",
                "minimum": 0
              },
              "profile": {
                "type": "array",
                "description": "set_payoff: one pick per PLAYER",
                "items": {
                  "type": "object",
                  "properties": {
                    "stakeholder": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "stakeholder",
                    "action"
                  ]
                }
              },
              "values": {
                "type": "array",
                "description": "set_payoff: 0-10 per dimension; COST 10 = very costly",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "enum": [
                        "SAFETY",
                        "ETHICS",
                        "LEGALITY",
                        "COST",
                        "REPUTATION",
                        "RELATIONSHIPS",
                        "WELLBEING",
                        "EFFICIENCY",
                        "PUBLIC_TRUST",
                        "LONG_TERM_VALUE"
                      ]
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "dimension",
                    "value"
                  ]
                }
              },
              "constraint_kind": {
                "type": "string",
                "enum": [
                  "LEGAL",
                  "ETHICAL",
                  "SAFETY",
                  "POLICY",
                  "PHYSICAL",
                  "RESOURCE"
                ]
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scenario_fields": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "decision_owner": {
                    "type": "string"
                  },
                  "stakes": {
                    "type": "string"
                  },
                  "time_horizon_label": {
                    "type": "string"
                  },
                  "institution": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "repeated": {
                    "type": "boolean"
                  },
                  "information_asymmetry": {
                    "type": "boolean"
                  },
                  "zero_sum": {
                    "type": "boolean"
                  }
                }
              },
              "rationale": {
                "type": "string",
                "description": "why; shown to the user"
              },
              "source": {
                "type": "string",
                "enum": [
                  "ai_inferred",
                  "user_stated"
                ]
              },
              "quote": {
                "type": "string",
                "description": "required when source = user_stated: the user's exact words"
              }
            },
            "required": [
              "type",
              "rationale"
            ]
          }
        }
      },
      "required": [
        "summary",
        "ops"
      ]
    }
  },
  {
    "type": "function",
    "name": "run_analysis",
    "description": "Runs the on-device engine (32 framework modules plus the recommendation engine) on the APPLIED model and returns a digest with the executive status, pathways, confidence, frameworks, disagreements, value-of-information items, risks and provenance.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "type": "function",
    "name": "show_support",
    "description": "Shows the app's support and crisis card (the clinician's contact details and local helplines configured in Settings). Use it whenever the user's safety, or someone else's, may be at risk.",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "self_harm",
            "harm_to_others",
            "abuse",
            "immediate_danger",
            "distress"
          ]
        }
      },
      "required": [
        "reason"
      ]
    }
  },
  {
    "type": "function",
    "name": "show_understanding",
    "description": "Shows the user a plain-language recap of what you've understood so far, with \"Looks right\" and \"Fix something\" buttons. Write it as short bullets with no jargon. The app adds nothing to it.",
    "parameters": {
      "type": "object",
      "properties": {
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "required": [
        "bullets"
      ]
    }
  },
  {
    "type": "function",
    "name": "stress_test_inferred",
    "description": "Moves each AI-inferred payoff up and down by `perturbation` x 10 points, one at a time, re-runs the engine each time, and reports whether the recommendation flips.",
    "parameters": {
      "type": "object",
      "properties": {
        "perturbation": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.5,
          "description": "default 0.25"
        }
      },
      "required": []
    }
  },
  {
    "type": "function",
    "name": "update_memory",
    "description": "Stores or resolves memory items for this decision. They are sent back to you in the app context on later turns.",
    "parameters": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "FACT",
                  "OPEN_QUESTION",
                  "PREFERENCE",
                  "DECISION_NOTE"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 300
              },
              "quote": {
                "type": "string",
                "description": "For FACT: the user's exact words"
              }
            },
            "required": [
              "kind",
              "text"
            ]
          }
        },
        "resolve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "memory item ids"
        }
      },
      "required": []
    }
  },
