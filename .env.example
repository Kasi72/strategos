# Strategos 2.0 — developer environment
# Copy to `.env` (gitignored) and fill in. Never commit `.env`.
# Load into your shell before running Gradle:
#   set -a; source .env; set +a
#
# The app itself never reads this file. End users enter their xAI key in
# Settings → AI (blueprint §11.5.1). These values are only for local
# builds, the live API spike test, and release signing.

# ── LLM provider: Groq (used only by XaiLiveSpikeTest, blueprint §9.5) ─
# The variable names still say XAI_* but the provider is now Groq (decision 2026-10-23).
# Create a key at https://console.groq.com (keys start with gsk_). GROQ_API_KEY is also accepted by the spike test.
XAI_API_KEY=
XAI_BASE_URL=https://api.groq.com/openai/v1
# Must match AgentConfig.MODEL_OPTIONS
XAI_MODEL=openai/gpt-oss-20b
XAI_MODEL_ECONOMY=openai/gpt-oss-120b

# ── Release signing (blueprint Phase 0.1) ────────────────────────────
# Alternative to keystore.properties. Leave blank for debug builds.
STRATEGOS_STORE_FILE=
STRATEGOS_STORE_PASSWORD=
STRATEGOS_KEY_ALIAS=strategos
STRATEGOS_KEY_PASSWORD=

# ── Android SDK (only if Gradle can't find it) ───────────────────────
# ANDROID_HOME=/Users/<you>/Library/Android/sdk

# ── Strategos server v4 (server/, docker-compose.yml) ─────────────────
# Read by `./gradlew :server:run` (after `set -a; source .env; set +a`) and by docker compose.
# DeepSeek is the day-1 provider. Any OpenAI-compatible provider works: set LLM_PROVIDER to its name,
# plus LLM_BASE_URL and LLM_MODEL. The key is only ever held in memory.
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
PORT=8080
# SQLite locally; on a server: jdbc:postgresql://db:5432/strategos?user=strategos&password=...
DATABASE_URL=jdbc:sqlite:./strategos.db
# The memory service from docker-compose. Leave empty to use only the offline memory.
GRAPHITI_URL=http://localhost:8000
# Embeddings for Graphiti memory: Voyage AI (https://dash.voyageai.com). Pick the model before real use: changing it later
# means re-embedding the memory. EMBEDDING_PROVIDER=ollama (with `--profile local-embeddings`) runs a local model instead.
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIM=1024
# http: MCP at POST /mcp next to the API. stdio: for Claude Desktop / Claude Code (see server/README.md).
MCP_TRANSPORT=http
# Set on any server reachable by others: every /api and /mcp call then needs "Authorization: Bearer <token>".
STRATEGOS_AUTH_TOKEN=
# A passphrase; when set, journal entries are encrypted at rest.
JOURNAL_ENCRYPTION_KEY=
# Extra browser origins allowed to call the API (comma-separated), e.g. https://strategos.example.com
CORS_ORIGINS=
