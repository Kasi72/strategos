# Strategos 2.0 — developer environment
# Copy to `.env` (gitignored) and fill in. Never commit `.env`.
# Load into your shell before running Gradle:
#   set -a; source .env; set +a
#
# The app itself never reads this file. End users enter their xAI key in
# Settings → AI (blueprint §11.5.1). These values are only for local
# builds, the live API spike test, and release signing.

# ── LLM provider: Groq (used only by XaiLiveSpikeTest, blueprint §9.5) ─
# The variable names still say XAI_* but the provider is now Groq (decision 2026-10-23).
# Create a key at https://console.groq.com (keys start with gsk_). GROQ_API_KEY is also accepted by the spike test.
XAI_API_KEY=
XAI_BASE_URL=https://api.groq.com/openai/v1
# Must match AgentConfig.MODEL_OPTIONS
XAI_MODEL=openai/gpt-oss-20b
XAI_MODEL_ECONOMY=openai/gpt-oss-120b

# ── Release signing (blueprint Phase 0.1) ────────────────────────────
# Alternative to keystore.properties. Leave blank for debug builds.
STRATEGOS_STORE_FILE=
STRATEGOS_STORE_PASSWORD=
STRATEGOS_KEY_ALIAS=strategos
STRATEGOS_KEY_PASSWORD=

# ── Android SDK (only if Gradle can't find it) ───────────────────────
# ANDROID_HOME=/Users/<you>/Library/Android/sdk
